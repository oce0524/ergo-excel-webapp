# 예시 파일 (이 파일은 깃허브에 올려도 됨 - 실제 비밀번호 없음)
# 실제 값은 .streamlit/secrets.toml 에 넣으세요. (그 파일은 .gitignore 로 제외)
# Streamlit Cloud 에 배포할 때는 앱 설정 > Secrets 에 아래 내용을 붙여넣으세요.

app_password = "여기에_화면잠금_비밀번호"

[postgres]
host = "aws-0-<지역>.pooler.supabase.com"   # Supabase > Project Settings > Database > Connection pooling 의 호스트
port = 5432                                   # 세션 모드 5432 (또는 트랜잭션 6543)
user = "postgres.<프로젝트참조ID>"
password = "여기에_DB_비밀번호"
dbname = "postgres"
